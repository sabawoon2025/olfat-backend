APP_NAME="Olfat Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=olfat
DB_USERNAME=olfat_user
DB_PASSWORD=change-me-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

SANCTUM_TOKEN_EXPIRATION=720

# Scheduler HTTP trigger (only needed when no system cron is available, e.g. Vercel).
# Random 32+ chars. Leave empty to disable GET /api/cron/schedule.
CRON_SECRET=

# Database backups (php artisan db:backup, scheduled daily at 02:00).
BACKUP_DISK=local
BACKUP_DIRECTORY=backups
BACKUP_KEEP_DAYS=30

# First production admin (required for php artisan db:seed in production).
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=change-me-at-least-12-chars

# Password reset codes are emailed. Use smtp/smtps in production — "log" only writes to the log.
# Gmail: MAIL_SCHEME=smtps MAIL_HOST=smtp.gmail.com MAIL_PORT=465 + app password
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
