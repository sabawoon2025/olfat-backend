# ---------------------------------------------------------------------------
# Environment variables for Vercel (Project > Settings > Environment Variables)
# Copy each KEY=VALUE into the Vercel dashboard, or import this file with:
#   vercel env pull / vercel env add
# Never commit a real .env; this file only documents the required keys.
# ---------------------------------------------------------------------------

APP_NAME="Olfat Backend"
APP_ENV=production
# php artisan key:generate --show   (paste the base64:... value)
APP_KEY=
APP_DEBUG=false
# Your Vercel production URL or custom domain (https:// is required)
APP_URL=https://your-project.vercel.app
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ---- Database (external managed DB; Vercel functions have no local DB) ----
# Option A: PostgreSQL (Neon via Vercel Marketplace / Supabase)
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Option B: MySQL 8 (TiDB Cloud Serverless, Aiven, PlanetScale, Railway)
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=olfat
# DB_USERNAME=
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/etc/pki/tls/certs/ca-bundle.crt

# ---- Serverless-safe drivers (filesystem is read-only except /tmp) ----
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file

# ---- Security ----
BCRYPT_ROUNDS=12
SANCTUM_TOKEN_EXPIRATION=720
# Random 32+ char string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/schedule (see "crons" in vercel.json).
CRON_SECRET=

# ---- First production admin (used once by: php artisan db:seed --force) ----
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=change-me-at-least-12-chars

# ---- Backups (local disk is ephemeral on Vercel) ----
# Rely on the DB provider's automated backups / PITR, and run
# `php artisan db:backup` from your PC against DB_URL for offline copies.
BACKUP_DISK=local
BACKUP_KEEP_DAYS=30

# Password reset codes are emailed only (never returned in the API response).
# Prefer Resend on Vercel — Gmail SMTP is often blocked from serverless hosts.
# 1) Create a free key at https://resend.com
# 2) Set MAIL_MAILER=resend and RESEND_API_KEY
# 3) MAIL_FROM_ADDRESS must be a verified sender (or onboarding@resend.dev for tests)
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"
# Optional Gmail SMTP (may fail on Vercel):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
